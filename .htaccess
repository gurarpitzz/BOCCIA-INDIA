RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 301 Redirects from old WordPress URLs (handling optional trailing slash)
RewriteRule ^contact-us/?$ /contact.php [R=301,L]
RewriteRule ^about-boccia/?$ /page.php?section=about&slug=about-boccia [R=301,L]
RewriteRule ^classification/?$ /page.php?section=sport&slug=classification [R=301,L]
RewriteRule ^equipment/?$ /page.php?section=sport&slug=equipment [R=301,L]
RewriteRule ^rules/?$ /page.php?section=sport&slug=rules [R=301,L]
RewriteRule ^anti-doping/?$ /page.php?section=sport&slug=anti-doping [R=301,L]
RewriteRule ^register-player\.php$ /get-involved/register-player.php [R=301,L]
RewriteRule ^register-official\.php$ /get-involved/register-official.php [R=301,L]
RewriteRule ^home-old/?$ /index.php [R=301,L]

# Author profiles redirection to homepage
RewriteRule ^author/.*$ /index.php [R=301,L]

# Define custom 404 error page for clean SEO and user experience
ErrorDocument 404 /404.php
